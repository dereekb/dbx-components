{
  "name": "openrouter",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/openrouter/src",
  "projectType": "library",
  "tags": ["publishable"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/openrouter"],
      "options": {
        "commands": [
          {
            "command": "npx nx run openrouter:build-base"
          },
          {
            "command": "npx nx run openrouter-firebase:build-base"
          },
          {
            "command": "npx nx run openrouter-firebase-server:build-base"
          },
          {
            "description": "normalize + verify the ESM-only package shape",
            "command": "node tools/scripts/finalize-esm-exports.mjs dist/packages/openrouter"
          }
        ],
        "parallel": false
      }
    },
    "build-base": {
      "dependsOn": []
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "run-all-tests": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "description": "run openrouter tests",
            "command": "npx nx test openrouter"
          },
          {
            "description": "run openrouter-firebase tests",
            "command": "npx nx test openrouter-firebase"
          },
          {
            "description": "run openrouter-firebase-server tests. Should be called within a Firebase emulator environment",
            "command": "npx nx run-tests openrouter-firebase-server"
          }
        ],
        "color": true,
        "parallel": false
      }
    },
    "ci-publish-npmjs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./dist/packages/openrouter && npm publish --access public"
      }
    }
  }
}
