{
  "name": "discord",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/discord/src",
  "projectType": "library",
  "tags": ["publishable"],
  "implicitDependencies": ["util-fetch", "!util-test"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/discord"],
      "options": {
        "command": "npx nx run discord:build-base",
        "color": true
      }
    },
    "build-base": {
      "dependsOn": []
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "ci-publish-npmjs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./dist/packages/discord && npm publish --access public"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "{projectRoot}/../../coverage/packages/discord"
      }
    }
  }
}
