{
  "name": "nestjs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/nestjs/src",
  "projectType": "library",
  "tags": ["publishable"],
  "implicitDependencies": ["util", "!util-test"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/nestjs"],
      "options": {
        "commands": [
          {
            "command": "npx nx run nestjs:build-base"
          },
          {
            "command": "npx nx run nestjs-stripe:build-base"
          },
          {
            "command": "npx nx run nestjs-mailgun:build-base"
          },
          {
            "command": "npx nx run nestjs-vapiai:build-base"
          },
          {
            "command": "npx nx run nestjs-openai:build-base"
          },
          {
            "command": "npx nx run nestjs-openrouter:build-base"
          },
          {
            "command": "npx nx run nestjs-twilio:build-base"
          },
          {
            "command": "npx nx run nestjs-typeform:build-base"
          },
          {
            "command": "npx nx run nestjs-eslint:build-base"
          },
          {
            "description": "normalize + verify the ESM-only package shape",
            "command": "node tools/scripts/finalize-esm-exports.mjs dist/packages/nestjs"
          }
        ],
        "parallel": false
      },
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/packages/nestjs/eslint/**/*",
        "!{workspaceRoot}/packages/nestjs/eslint/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
        "{workspaceRoot}/packages/nestjs/mailgun/**/*",
        "!{workspaceRoot}/packages/nestjs/mailgun/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
        "{workspaceRoot}/packages/nestjs/openai/**/*",
        "!{workspaceRoot}/packages/nestjs/openai/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
        "{workspaceRoot}/packages/nestjs/openrouter/**/*",
        "!{workspaceRoot}/packages/nestjs/openrouter/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
        "{workspaceRoot}/packages/nestjs/stripe/**/*",
        "!{workspaceRoot}/packages/nestjs/stripe/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
        "{workspaceRoot}/packages/nestjs/twilio/**/*",
        "!{workspaceRoot}/packages/nestjs/twilio/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
        "{workspaceRoot}/packages/nestjs/typeform/**/*",
        "!{workspaceRoot}/packages/nestjs/typeform/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
        "{workspaceRoot}/packages/nestjs/vapiai/**/*",
        "!{workspaceRoot}/packages/nestjs/vapiai/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)"
      ]
    },
    "build-base": {
      "dependsOn": []
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "run-all-tests": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "description": "run nestjs tests",
            "command": "npx nx test nestjs"
          },
          {
            "description": "run nestjs-stripe tests",
            "command": "npx nx test nestjs-stripe"
          },
          {
            "description": "run nestjs-mailgun tests",
            "command": "npx nx test nestjs-mailgun"
          },
          {
            "description": "run nestjs-vapiai tests",
            "command": "npx nx test nestjs-vapiai"
          },
          {
            "description": "run nestjs-openai tests",
            "command": "npx nx test nestjs-openai"
          },
          {
            "description": "run nestjs-openrouter tests",
            "command": "npx nx test nestjs-openrouter"
          },
          {
            "description": "run nestjs-twilio tests",
            "command": "npx nx test nestjs-twilio"
          },
          {
            "description": "run nestjs-typeform tests",
            "command": "npx nx test nestjs-typeform"
          },
          {
            "description": "run nestjs-eslint tests",
            "command": "npx nx test nestjs-eslint"
          }
        ],
        "color": true,
        "parallel": false
      }
    },
    "ci-publish-npmjs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./dist/packages/nestjs && npm publish --access public"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "{projectRoot}/../../coverage/packages/nestjs"
      }
    }
  }
}
