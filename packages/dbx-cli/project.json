{
  "name": "dbx-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/dbx-cli/src",
  "projectType": "library",
  "tags": ["publishable"],
  "implicitDependencies": ["util", "firebase", "date", "model", "rxjs", "util-fetch", "nestjs"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/dbx-cli"],
      "options": {
        "commands": [
          {
            "command": "npx nx run dbx-cli:build-base"
          },
          {
            "command": "npx nx run dbx-cli-manifest-extract:build-base"
          },
          {
            "command": "npx nx run dbx-cli-route:build-base"
          },
          {
            "command": "npx nx run dbx-cli-firebase-api-manifest:build-base"
          },
          {
            "command": "npx nx run dbx-cli-lint-cache:build-base"
          },
          {
            "command": "npx nx run dbx-cli-generate-firestore-indexes:build-base"
          },
          {
            "command": "npx nx run dbx-cli-firestore-query-manifest:build-base"
          },
          {
            "command": "npx nx run dbx-cli-generate-mcp-manifest:build-base"
          },
          {
            "command": "npx nx run dbx-cli-generate-route-manifest:build-base"
          },
          {
            "command": "npx nx run dbx-cli-eslint:build-base"
          },
          {
            "command": "npx nx run dbx-cli-validate:build-base"
          },
          {
            "command": "npx nx run dbx-cli-model-test:build-base"
          },
          {
            "command": "npx nx run dbx-cli-test:build-base"
          },
          {
            "description": "normalize + verify the ESM-only package shape",
            "command": "node tools/scripts/finalize-esm-exports.mjs dist/packages/dbx-cli"
          }
        ],
        "parallel": false
      }
    },
    "build-base": {
      "dependsOn": []
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": [],
      "options": {
        "commands": ["npx tsc -p packages/dbx-cli/tsconfig.lib.json --noEmit", "npx tsc -p packages/dbx-cli/tsconfig.spec.json --noEmit"],
        "cwd": "{workspaceRoot}",
        "parallel": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["packages/dbx-cli/src/**/*.{ts,tsx}"]
      }
    },
    "run-tests": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "description": "run dbx-cli tests",
            "command": "npx nx test dbx-cli"
          }
        ],
        "color": true,
        "parallel": false
      }
    },
    "run-all-tests": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          {
            "description": "run dbx-cli tests",
            "command": "npx nx test dbx-cli"
          },
          {
            "description": "run dbx-cli-firestore-indexes tests",
            "command": "npx nx test dbx-cli-firestore-indexes"
          },
          {
            "description": "run dbx-cli-firestore-query-manifest tests",
            "command": "npx nx test dbx-cli-firestore-query-manifest"
          },
          {
            "description": "run dbx-cli-firestore-rules tests",
            "command": "npx nx test dbx-cli-firestore-rules"
          },
          {
            "description": "run dbx-cli-manifest-extract tests",
            "command": "npx nx test dbx-cli-manifest-extract"
          },
          {
            "description": "run dbx-cli-route tests",
            "command": "npx nx test dbx-cli-route"
          },
          {
            "description": "run dbx-cli-test tests",
            "command": "npx nx run-tests dbx-cli-test"
          }
        ],
        "color": true,
        "parallel": false
      }
    },
    "ci-publish-npmjs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./dist/packages/dbx-cli && npm publish --access public"
      }
    }
  }
}
