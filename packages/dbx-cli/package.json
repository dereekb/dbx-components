{
  "name": "@dereekb/dbx-cli",
  "version": "14.0.0",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "dbx-cli-generate-firebase-api-manifest": "firebase-api-manifest/main.js",
    "dbx-cli-generate-firestore-indexes": "generate-firestore-indexes/main.js",
    "dbx-cli-generate-firestore-query-manifest": "firestore-query-manifest/main.js",
    "dbx-cli-generate-mcp-manifest": "generate-mcp-manifest/main.js",
    "dbx-cli-generate-route-manifest": "generate-route-manifest/main.js",
    "dbx-cli-lint-cache": "lint-cache/main.js"
  },
  "exports": {
    "./eslint": {
      "types": "./eslint/index.d.ts",
      "import": "./eslint/index.esm.js",
      "default": "./eslint/index.esm.js"
    },
    "./firebase-api-manifest": {
      "default": "./firebase-api-manifest/main.js"
    },
    "./firestore-query-manifest": {
      "default": "./firestore-query-manifest/main.js"
    },
    "./generate-firestore-indexes": {
      "default": "./generate-firestore-indexes/main.js"
    },
    "./generate-mcp-manifest": {
      "default": "./generate-mcp-manifest/main.js"
    },
    "./generate-route-manifest": {
      "default": "./generate-route-manifest/main.js"
    },
    "./lint-cache": {
      "default": "./lint-cache/main.js"
    },
    "./manifest-extract": {
      "types": "./manifest-extract/index.d.ts",
      "import": "./manifest-extract/index.esm.js",
      "default": "./manifest-extract/index.esm.js"
    },
    "./model-test": {
      "types": "./model-test/index.d.ts",
      "import": "./model-test/index.esm.js",
      "default": "./model-test/index.esm.js"
    },
    "./route": {
      "types": "./route/index.d.ts",
      "import": "./route/index.esm.js",
      "default": "./route/index.esm.js"
    },
    "./test": {
      "types": "./test/index.d.ts",
      "import": "./test/index.esm.js",
      "default": "./test/index.esm.js"
    },
    "./validate": {
      "default": "./validate/index.js"
    }
  },
  "peerDependencies": {
    "@dereekb/date": "14.0.0",
    "@dereekb/firebase": "14.0.0",
    "@dereekb/model": "14.0.0",
    "@dereekb/nestjs": "14.0.0",
    "@dereekb/util": "14.0.0",
    "@nestjs/common": "^12.0.1",
    "arktype": "^2.2.0",
    "firebase": "^12.18.0",
    "jiti": "2.7.0",
    "oxfmt": "^0.66.0",
    "ts-morph": "^28.0.0",
    "vitest": "4.1.11",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@angular/core": "22.1.4",
    "@types/yargs": "^17.0.35",
    "eslint": "10.9.1"
  }
}
