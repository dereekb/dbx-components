    {
      "slug": "parse-arktype-fields-with-messages",
      "name": "parseArktypeFieldsWithMessages",
      "kind": "function",
      "category": "validator",
      "module": "@dereekb/model",
      "subpath": "type/type.field",
      "signature": "parseArktypeFieldsWithMessages(config: ParseArktypeFieldsWithMessagesConfig<T>): Type<T>['infer']",
      "description": "Validate an object's fields with an arktype type and report the FIRST failing field (by\n{@link ParseArktypeFieldsWithMessagesConfig.keys} order) as `<label>.<field> must <rule> (got <value>). <remedy>`.\nNested rule objects get their unknown keys checked first. A field set to `undefined` counts as absent.\n\nA caller that needs a canonical key order (or trimming) assembles its own result from the returned value; an\nextension can return it as-is.",
      "params": [
        {
          "name": "config",
          "type": "ParseArktypeFieldsWithMessagesConfig<T>",
          "description": "- The labels, the object, the type, the key order and the rules.",
          "optional": false
        }
      ],
      "returns": "The validated value, typed by the arktype type.",
      "tags": [
        "validator",
        "arktype",
        "config",
        "error-message",
        "keys",
        "parse",
        "fields",
        "with",
        "messages",
        "parsearktypefieldswithmessages"
      ],
      "example": "const widgetType = type({ name: 'string > 0', 'size?': 'number.integer > 0' });\n\nparseArktypeFieldsWithMessages({\n  schemaLabel: 'my-app config',\n  label: 'widget',\n  value: { name: 'a', size: 0 },\n  type: widgetType,\n  keys: ['name', 'size'],\n  rules: { name: { must: 'be a non-empty name' }, size: { must: 'be a positive integer', remedy: 'Remove the key to use the default size.' } }\n});\n// throws \"my-app config: widget.size must be a positive integer (got 0). Remove the key to use the default size.\""
    },
