{
  "name": "dbx-components-mcp",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/dbx-components-mcp/src",
  "projectType": "library",
  "tags": ["scope:mcp", "type:server", "publishable"],
  "targets": {
    "generate-firebase-models": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/packages/dbx-cli/generated/firebase-models.generated.ts"],
      "inputs": ["{projectRoot}/scripts/extract-firebase-models.mjs", "{workspaceRoot}/packages/firebase/src/lib/model/**/*.ts"],
      "options": {
        "command": "node packages/dbx-components-mcp/scripts/extract-firebase-models.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "generate-manifests": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": [
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-util.semantic-types.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-model.semantic-types.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-date.semantic-types.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-firebase.semantic-types.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-firebase-server.semantic-types.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-dbx-web.ui-components.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-dbx-firebase.ui-components.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-dbx-form.forge-fields.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-dbx-core.pipes.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-dbx-core.actions.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-dbx-core.filters.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-util.utils.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-util-fetch.utils.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-date.utils.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-rxjs.utils.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-model.utils.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-firebase.utils.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-firebase-server.utils.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-firebase.model-snapshot-fields.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-firebase.model-firebase-index.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-demo.dbx-docs-ui-examples.mcp.generated.json"
      ],
      "inputs": [
        "{projectRoot}/scripts/generate-manifests.mjs",
        "{workspaceRoot}/packages/dbx-cli/src/lib/mcp-scan/scan/**/*.ts",
        "{workspaceRoot}/packages/dbx-cli/src/lib/mcp-scan/manifest/**/*.ts",
        "{workspaceRoot}/packages/dbx-cli/src/lib/mcp-scan/registry/**/*.ts",
        "{workspaceRoot}/packages/dbx-cli/src/lib/scan-helpers/**/*.ts",
        "{workspaceRoot}/packages/dbx-cli/firestore-indexes/src/**/*.ts",
        "{workspaceRoot}/dbx-mcp.config.json",
        "{workspaceRoot}/packages/util/src/**/*.ts",
        "{workspaceRoot}/packages/util/fetch/src/**/*.ts",
        "{workspaceRoot}/packages/model/src/**/*.ts",
        "{workspaceRoot}/packages/date/src/**/*.ts",
        "{workspaceRoot}/packages/firebase/src/**/*.ts",
        "{workspaceRoot}/packages/firebase-server/src/**/*.ts",
        "{workspaceRoot}/packages/firebase-server/test/src/**/*.ts",
        "{workspaceRoot}/packages/dbx-web/src/**/*.ts",
        "{workspaceRoot}/packages/dbx-firebase/src/**/*.ts",
        "{workspaceRoot}/packages/dbx-form/src/**/*.ts",
        "{workspaceRoot}/packages/dbx-core/src/lib/pipe/**/*.ts",
        "{workspaceRoot}/packages/dbx-core/src/lib/action/**/*.ts",
        "{workspaceRoot}/packages/dbx-core/src/lib/filter/**/*.ts",
        "{workspaceRoot}/packages/rxjs/src/**/*.ts",
        "{workspaceRoot}/apps/demo/src/app/modules/doc/modules/examples/**/*.ts"
      ],
      "options": {
        "command": "node packages/dbx-components-mcp/scripts/generate-manifests.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "generate-css-tokens": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": [
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-dbx-web.tokens.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/dereekb-dbx-form.tokens.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/angular-material-m3.tokens.mcp.generated.json",
        "{workspaceRoot}/packages/dbx-cli/generated/angular-material-mdc.tokens.mcp.generated.json"
      ],
      "inputs": [
        "{projectRoot}/scripts/generate-css-tokens.mjs",
        "{workspaceRoot}/packages/dbx-cli/src/lib/mcp-scan/manifest/sources/angular-material-m3.tokens.source.json",
        "{workspaceRoot}/packages/dbx-cli/src/lib/mcp-scan/manifest/sources/angular-material-mdc.tokens.source.json",
        "{workspaceRoot}/packages/dbx-web/src/lib/**/*.scss",
        "{workspaceRoot}/packages/dbx-form/src/lib/**/*.scss"
      ],
      "options": {
        "commands": [
          "node packages/dbx-components-mcp/scripts/generate-css-tokens.mjs --source=dbx-web",
          "node packages/dbx-components-mcp/scripts/generate-css-tokens.mjs --source=dbx-form",
          "node packages/dbx-components-mcp/scripts/generate-css-tokens.mjs --source=mat-sys",
          "node packages/dbx-components-mcp/scripts/generate-css-tokens.mjs --source=mdc"
        ],
        "cwd": "{workspaceRoot}",
        "parallel": false
      }
    },
    "regenerate": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate-firebase-models", "generate-manifests", "generate-css-tokens"],
      "options": {
        "command": "echo \"dbx-components-mcp regeneration complete\""
      }
    },
    "build": {
      "executor": "nx:noop",
      "outputs": [],
      "dependsOn": ["build-base"],
      "metadata": {
        "description": "A pure aggregation node. This package has no subpath entry points and no post-build step, so once the nested `npx nx run dbx-components-mcp:build-base` shell-out became a dependsOn edge there was no command left to run -- hence `nx:noop` (a bare dependsOn with no executor is invalid; createTask throws). `outputs` is empty because build-base is the sole writer of dist/packages/dbx-components-mcp; declaring the directory here too would make a second task own it. `^build` moved onto build-base, where the compile that actually needs finalized upstream dist lives."
      }
    },
    "build-base": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "dependsOn": ["^build", "generate-firebase-models", "generate-manifests", "generate-css-tokens"],
      "metadata": {
        "description": "`^build` (not `^build-base`: @dereekb/* imports are remapped to the dist DIRECTORY, so TypeScript reads that directory's package.json `exports`, which the dependency's own `build` finalizes) alongside the three pre-existing generate targets. The `^build` used to sit on the `build` wrapper that shelled out to this target; it belongs on the compile."
      },
      "options": {
        "outputPath": "dist/packages/dbx-components-mcp",
        "main": "packages/dbx-components-mcp/bin/dbx-components-mcp.ts",
        "tsConfig": "packages/dbx-components-mcp/tsconfig.lib.json",
        "format": ["esm"],
        "platform": "node",
        "target": "node20",
        "bundle": true,
        "thirdParty": false,
        "skipTypeCheck": true,
        "declaration": false,
        "esbuildOptions": {
          "banner": {
            "js": "#!/usr/bin/env node\nimport { createRequire as __createRequire } from 'node:module';\nconst require = __createRequire(import.meta.url);"
          }
        },
        "assets": [
          {
            "glob": "README.md",
            "input": "packages/dbx-components-mcp",
            "output": "."
          },
          {
            "glob": "LICENSE",
            "input": ".",
            "output": "."
          },
          {
            "glob": "generated/*.json",
            "input": "packages/dbx-cli",
            "output": "."
          }
        ]
      },
      "configurations": {
        "production": {
          "minify": false,
          "sourcemap": false
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "ci-publish-npmjs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./dist/packages/dbx-components-mcp && npm publish --access public --tag latest"
      }
    }
  }
}
