{
  "name": "model",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/model/src",
  "projectType": "library",
  "tags": ["publishable"],
  "implicitDependencies": ["!util-test"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/model"],
      "options": {
        "color": true,
        "commands": [
          {
            "command": "npx nx run model:build-base"
          },
          {
            "description": "normalize + verify the ESM-only package shape",
            "command": "node tools/scripts/finalize-esm-exports.mjs dist/packages/model"
          }
        ],
        "parallel": false
      }
    },
    "build-base": {
      "dependsOn": []
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "ci-publish-npmjs": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd ./dist/packages/model && npm publish --access public"
      }
    }
  }
}
