{
  "name": "@dereekb/microsoft",
  "version": "14.25.1",
  "sideEffects": false,
  "type": "module",
  "bin": {
    "msgraph-cli": "cli/index.js"
  },
  "exports": {
    "./nestjs": {
      "types": "./nestjs/index.d.ts",
      "import": "./nestjs/index.esm.js",
      "default": "./nestjs/index.esm.js"
    },
    "./cli": {
      "default": "./cli/index.js"
    }
  },
  "dbxClaude": {
    "refs": [
      {
        "name": "msgraph-cli",
        "triggers": [
          {
            "words": [
              "msgraph-cli",
              "msgraph",
              "Microsoft Graph",
              "graph.microsoft.com",
              "MSGRAPH_CLI_TOKEN_SOURCE",
              "MSGRAPH_CLI_TOKEN_COMMAND",
              "MSGRAPH_CLI_CONFIG_DIR",
              "Outlook mail",
              "Outlook inbox",
              "Outlook calendar",
              "OneDrive"
            ]
          },
          {
            "pathContains": [
              "/microsoft/cli/"
            ],
            "capabilities": [
              "dbx-components"
            ],
            "every": 8
          }
        ]
      }
    ]
  },
  "peerDependencies": {
    "@dereekb/dbx-cli": "14.25.1",
    "@dereekb/nestjs": "14.25.1",
    "@dereekb/rxjs": "14.25.1",
    "@dereekb/util": "14.25.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "express": "^5.2.1",
    "make-error": "^1.3.6",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1"
  }
}
