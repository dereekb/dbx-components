{
  "name": "@dereekb/trello",
  "version": "14.25.1",
  "sideEffects": false,
  "type": "module",
  "bin": {
    "trello-cli": "bin/index.js"
  },
  "exports": {
    "./nestjs": {
      "types": "./nestjs/index.d.ts",
      "import": "./nestjs/index.esm.js",
      "default": "./nestjs/index.esm.js"
    },
    "./cli": {
      "types": "./cli/index.d.ts",
      "import": "./cli/index.esm.js",
      "default": "./cli/index.esm.js"
    }
  },
  "dbxClaude": {
    "refs": [
      {
        "name": "trello-cli",
        "triggers": [
          {
            "words": [
              "trello-cli",
              "TRELLO_CLI_TOKEN_SOURCE",
              "TRELLO_CLI_TOKEN_COMMAND",
              "TRELLO_CLI_CONFIG_DIR",
              "TRELLO_CLI_BOARD",
              "TRELLO_CLI_EXTENSIONS",
              "TRELLO_CLI_NO_EXTENSIONS",
              "@dereekb/trello/cli",
              "runTrelloCli",
              "TrelloCliPlugin"
            ]
          },
          {
            "pathContains": [
              "/trello/cli/"
            ],
            "capabilities": [
              "dbx-components"
            ],
            "every": 8
          }
        ]
      }
    ]
  },
  "peerDependencies": {
    "@dereekb/dbx-cli": "14.25.1",
    "@dereekb/nestjs": "14.25.1",
    "@dereekb/rxjs": "14.25.1",
    "@dereekb/util": "14.25.1",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "express": "^5.2.1",
    "make-error": "^1.3.6",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.0.1"
  }
}
