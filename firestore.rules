rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // MARK: Utilities
    function userClaimsIsSysAdmin() {
      return request.auth.token.keys().hasAll(["a"]) && request.auth.token.a == 1;
    }

    function resourceIsPublished() {
      return resource != null && resource.data != null && resource.data.keys().hasAll(["published"]) && resource.data.published == true;
    }

    function resourceIsOwnedByAuthUserId() {
      return resource != null && request.auth != null && (resource.id == request.auth.uid);
    }

    function twoWayKeyRelatedResourceIsOwnedByAuthUserProfile() {
      // compare the resource's identifier which would be derived from the user's profile twoWayKey, which is pr_<id>
      return resource != null && request.auth != null && (resource.id == 'pr_' + request.auth.uid);
    }

    function resourceIsOwnedByAuthOwnershipKey() {
      // compares the "o" value against the auth's uid
      return resource != null && resource.data != null && resource.data.o != null && request.auth != null && (resource.data.o == 'pr/' + request.auth.uid);
    }

    function authUserHasGuestbookEntryForOwnershipKey() {
      // A SHARED FormSpace: `o` names a Guestbook rather than a Profile, and everyone who signed that
      // guestbook can read it. A GuestbookEntry's document id IS its author's uid, so "has this caller
      // signed?" is one exists() on a path built from the resource's own ownership key — no query, and no
      // membership array to keep in step with the entries themselves.
      //
      // The shape of `o` is asserted BEFORE it is interpolated into a path. `o` is server-written today,
      // but a predicate that builds a document path out of a stored value should not rest on that staying
      // true; the anchored single-segment match is what keeps `gb/x/gbe/<uid>` from resolving somewhere else.
      return resource != null && resource.data != null && resource.data.o != null && request.auth != null
        && resource.data.o.matches('^gb/[^/]+$')
        && exists(path('/databases/' + database + '/documents/' + resource.data.o + '/gbe/' + request.auth.uid));
    }

    function oidcEntryIsOwnedByAuthUserUid() {
      // OidcEntry stores the Firebase UID in `uid` (extracted from the oidc-provider payload).
      return resource != null && resource.data != null && resource.data.uid != null && request.auth != null && (resource.data.uid == request.auth.uid);
    }

    // MARK: Rules
    match /pr/{profile} {

      // users can read themselves
      allow get: if isProfileOwner() || userClaimsIsSysAdmin();

      // listing only allowed by admins not allowed
      // this affects query too!
      allow list: if userClaimsIsSysAdmin();

      function isProfileOwner() {
        return request.auth.uid == profile;
      }

    }

    match /gb/{guestbook} {
      allow read: if resourceIsPublished();
      allow list: if resourceIsPublished() || userClaimsIsSysAdmin(); // can only list published guestbooks

      match /gbe/{guestbookEntry} {

        // Can read any entry that is owned or published.
        allow get: if resourceIsPublished() || resourceIsOwnedByAuthUserId();

        // Can only query if the guestbook entry is published.
        allow list: if resourceIsPublished() || userClaimsIsSysAdmin();
      }
    }

    // collection group example
    // https://firebase.google.com/docs/firestore/security/rules-query#collection_group_queries_and_security_rules
    match /{path=**}/gbe/{guestbookEntry} {

      // Can read any entry that is owned or published.
      allow get: if resourceIsPublished() || resourceIsOwnedByAuthUserId();

      // Can only query if the guestbook entry is published.
      allow list: if resourceIsPublished() || userClaimsIsSysAdmin();
    }


    match /nu/{notificationUser} {
      // users can read themselves. A NotificationUser's document id is the user's uid, not a twoWayKey.
      allow read: if resourceIsOwnedByAuthUserId();
    }

    // MARK: UserExternalConnection
    match /uec/{userExternalConnection} {
      // The document id IS the user's uid. Use the path variable, not resourceIsOwnedByAuthUserId():
      // that helper requires resource != null, so it would deny a user who has connected nothing
      // (the common case — no document exists yet) with permission-denied instead of an empty read.
      allow get: if request.auth != null && request.auth.uid == userExternalConnection;

      // Exactly one document per user, always loaded by id. Denying list keeps the connected-provider
      // array (`c`) queryable server-side only.
      allow list: if false;

      // No write grant: disconnect goes through the update:disconnect callable, which is the only
      // way to keep this document consistent with its server-only credentials counterpart.
    }

    // NOTE: there is deliberately NO match block for /uecp (UserExternalConnectionPrivate).
    // Firestore rules do not cascade, so the implicit default-deny is what protects it; a block here
    // would only create an opportunity to accidentally grant access. Asserted by firestore.rules.spec.ts.

    // NOTE: for the same reason there is deliberately NO match block for /sys (SystemState) or
    // /sysp (SystemStatePrivate). SystemState is read/written server-side through the callable model
    // services, which gate it on sys-admin; SystemStatePrivate additionally holds secrets encrypted
    // at rest (e.g. the Zoho access token cache) and has no client story at all. Both are asserted
    // by firestore.rules.spec.ts.
    //
    // If an app does need to expose a specific SystemState document to clients, match that ONE
    // document id (e.g. `match /sys/myfeatureflags`) rather than adding a `/sys/{doc}` wildcard —
    // a wildcard would expose every other type in the collection along with it.

    match /ns/{notificationSummary} {
      allow read: if twoWayKeyRelatedResourceIsOwnedByAuthUserProfile(); // users can read themselves
    }

    match /nb/{notificationBox} {
      allow read: if resourceIsOwnedByAuthOwnershipKey(); // owners can read

      match /nbn/{notification} {
        // not allowed to read queued notifications
        allow read: if false;
      }

      match /nbnw/{notificationWeek} {

        // no need to view notification weeks
        allow read: if false;
      }
    }

    // MARK: StorageFile
    match /sf/{storageFile} {
      allow get: if userClaimsIsSysAdmin() || resourceIsOwnedByAuthOwnershipKey();
    }

    match /sfg/{storageFileGroup} {
      allow get: if userClaimsIsSysAdmin() || resourceIsOwnedByAuthOwnershipKey();
    }

    // MARK: Calendar
    match /cal/{calendar} {
      // owners can read their own calendar directly, so a client renders the model rather than the
      // published .ics. "list" is denied by omission; writes stay server-only via the default deny, since
      // the publish sweep's correctness rests on every write carrying the "s" flag.
      allow get: if userClaimsIsSysAdmin() || resourceIsOwnedByAuthOwnershipKey();
    }

    // MARK: FormSpace
    match /fsp/{formSpace} {
      // owners read and list their own in-progress forms. "list" is granted here — unlike /cal, which has
      // no list use case — because "my outstanding forms" is the screen the model exists for; it is scoped
      // by the SAME ownership predicate, so an unscoped list still fails.
      // Writes stay server-only via the default deny: every state transition carries invariants (the
      // submit lock, the "eat" clear, the monotonic upload counter) that a client write would bypass.
      //
      // A guestbook's SHARED space is reachable by everyone who signed that guestbook. Only `get` is
      // widened: a list rule is evaluated per candidate document, so the exists() would be one billed read
      // per result — and a shared space never needs listing, because its id is derived from the guestbook
      // and the client always knows it.
      allow get: if userClaimsIsSysAdmin() || resourceIsOwnedByAuthOwnershipKey() || authUserHasGuestbookEntryForOwnershipKey();
      allow list: if userClaimsIsSysAdmin() || resourceIsOwnedByAuthOwnershipKey();
    }

    // NOTE: there is deliberately NO match block for /orp (OpenRouterPrompt), /orpv
    // (OpenRouterPromptVersion) or /orrt (OpenRouterRunTask). They are server-only models: prompts are
    // authored through the admin-gated callable model API, and a run task carries the model's raw input
    // and output. The implicit default-deny is what protects them; a block here could only weaken that.

    // MARK: OIDC Adapter
    match /oidc_e/{entryId} {
      // Owners can read their own Client entries (type == 'Client' && o = 'pr/<uid>')
      // and their own Grant entries (type == 'Grant' && uid = <auth.uid>) so they can
      // see and revoke "apps with access to my account".
      allow get: if userClaimsIsSysAdmin()
        || resourceIsOwnedByAuthOwnershipKey()
        || (oidcEntryIsOwnedByAuthUserUid() && resource.data.type == 'Grant');
      allow list: if userClaimsIsSysAdmin()
        || (resourceIsOwnedByAuthOwnershipKey() && resource.data.type == 'Client')
        || (oidcEntryIsOwnedByAuthUserUid() && resource.data.type == 'Grant');
    }

  }
}
