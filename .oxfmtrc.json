{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSameLine": true,
  "singleQuote": true,
  "bracketSpacing": true,
  "trailingComma": "none",
  "quoteProps": "as-needed",
  "semi": true,
  "useTabs": false,
  "tabWidth": 2,
  "htmlWhitespaceSensitivity": "ignore",
  "endOfLine": "lf",
  "printWidth": 320,
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "/.angular",
    "/.circleci",
    "/.config",
    "/.firebase",
    "/.github",
    "/.claude",
    "/.husky",
    "/.reports",
    "/.vscode",
    "/dist",
    "/coverage",
    "/setup/**/*.template.json",
    "/packages/dbx-components-cli/templates/**/*.template.json",
    "**/*.generated.*",
    "/art",
    "/docker",
    ".commitlintrc.json",
    ".eslintrc.json",
    "*.md",
    "/.nx/cache",
    "/.nx/workspace-data"
  ]
}
