{
  "version": 1,
  "kind": "dbx-components",
  "project": "dbx-components",
  "capabilities": ["audit", "dbx-components"],
  "commit": {
    "autoCommit": {
      "enabled": true,
      "branches": ["develop", "claude/**", "feat/**"]
    }
  },
  "tests": {
    "default": { "runner": "npx nx" }
  },
  "builds": {
    "recovery": { "enabled": true, "target": "workspace:build-all" }
  },
  "capabilityConfig": {
    "block-nx-build": { "options": { "enabled": true } },
    "docker": {
      "options": {
        "serve": {
          "service": "demo-api-server",
          "containerName": "demo-api-server",
          "passEnv": ["OPENROUTER_API_KEY", "OPENROUTER_TEST_MODEL_ID", "OPENROUTER_FILE_SEARCH_VECTOR_STORE_ID"],
          "exec": {
            "command": ["npx", "firebase", "--project=default", "emulators:exec", "--only", "auth,firestore,storage"],
            "joinCommand": true
          }
        }
      }
    }
  }
}
