rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // MARK: Utilities
    function userClaimsIsSysAdmin() {
      return request.auth.token.keys().hasAll(["a"]) && request.auth.token.a == 1;
    }

    // MARK: Uploads under User
    match /uploads/u/{uid} {
      allow read: if isUploadUser() || userClaimsIsSysAdmin();

      // MARK: Test File
      // Mirrors STORAGE_FILE_PURPOSE_UPLOAD_POLICIES[USER_TEST_FILE_PURPOSE].
      match /test/{filename=**} {
        allow write: if (isUploadUser() && isAllowedTestFile()) || userClaimsIsSysAdmin();
      }

      // MARK: Log File
      // Mirrors STORAGE_FILE_PURPOSE_UPLOAD_POLICIES[USER_LOG_FILE_PURPOSE].
      match /log/{filename=**} {
        allow write: if (isUploadUser() && isAllowedLogFile()) || userClaimsIsSysAdmin();
      }

      // MARK: Resume File
      // Mirrors STORAGE_FILE_PURPOSE_UPLOAD_POLICIES[USER_RESUME_FILE_PURPOSE].
      match /resume.pdf {
        allow write: if (isUploadUser() && isAllowedResumeFile()) || userClaimsIsSysAdmin();
      }

      // MARK: FormSpace Files
      // Mirrors FORM_SPACE_UPLOAD_POLICY.
      // The path carries the FormSpace id and slot, so a write is confined to the uploader's own namespace
      // without any Firestore read. Whether that FormSpace exists, is still a draft, declares this slot, or
      // has upload budget left cannot be known here — that is enforced authoritatively by
      // formSpaceStorageFileUploadInitializers() after the bytes land. These bounds are the OUTER limit.
      //
      // That also covers WHO may upload. Any signed-in user can write under their own {uid} for any
      // formSpaceId, which is deliberate: a SHARED space is filled by many people, each in their own
      // namespace, and only the initializer can read the space to learn whether this one is a member.
      match /formSpace/{formSpaceId}/{allPaths=**} {
        allow write: if (isUploadUser() && isAllowedFormSpaceFile()) || userClaimsIsSysAdmin();
      }

      // MARK: Avatar
      // Mirrors STORAGE_FILE_PURPOSE_UPLOAD_POLICIES[USER_AVATAR_PURPOSE].
      match /avatar.img {
        allow write: if isUploadUser() || userClaimsIsSysAdmin() && isAllowedAvatarSize();
      }

      function isUploadUser() {
        return request.auth.uid == uid;
      }

      function isAllowedAvatarSize() {
        // max 2mb image (client-side compression downsizes before upload)
        return request.resource.size < 2 * 1024 * 1024 && request.resource.contentType.matches('image/.*')
      }

      function isAllowedTestFile() {
        // max 8mb; text/plain or image/jpeg or image/png
        return request.resource.size < 8 * 1024 * 1024 && (
          request.resource.contentType == 'text/plain'
            || request.resource.contentType == 'image/jpeg'
            || request.resource.contentType == 'image/png'
        )
      }

      function isAllowedLogFile() {
        // max 2mb; text/plain only
        return request.resource.size < 2 * 1024 * 1024 && request.resource.contentType == 'text/plain'
      }

      function isAllowedFormSpaceFile() {
        // max 10mb; mirrors DEFAULT_FORM_SPACE_MAX_FILE_SIZE_BYTES and DEFAULT_FORM_SPACE_ALLOWED_MIME_TYPES.
        // Per-type and per-slot rules narrow this further, server-side.
        return request.resource.size < 10 * 1024 * 1024 && (
          request.resource.contentType == 'application/pdf'
            || request.resource.contentType == 'image/jpeg'
            || request.resource.contentType == 'image/png'
            || request.resource.contentType == 'text/plain'
        )
      }

      function isAllowedResumeFile() {
        // max 10kb; application/pdf only. Mirrors USER_RESUME_FILE_UPLOADS_MAX_FILE_SIZE_BYTES, which is
        // deliberately tiny because the resume is carried to OpenRouter as inline base64 on every attempt.
        return request.resource.size < 10 * 1024 && request.resource.contentType == 'application/pdf'
      }
    }

    // MARK: User Files
    match /u/{uid} {
      allow read: if isUser() || userClaimsIsSysAdmin();  // anyone can read anyone else's files

      match /test {
        allow read: if false;  // can only be read by the user
      }

      match /avatar {
        allow read: if true;  // anyone can read anyone else's avatar
      }

      function isUser() {
        return request.auth.uid == uid;
      }
    }

    match /{allPaths=**} {
      allow read, write: if false;
      allow list: if false; // not allowed to list anywhere
    }

  }

}
