{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "//cacheDirectory": "Pins the Nx cache AND the task DB into the checkout. Without it, Nx 23.2 resolves both to ~/.nx/<workspace-id>/{cache,databases} (see node_modules/nx/dist/src/utils/cache-directory.js). The id derives from the git remote, so the container computes the SAME id as the host but resolves it against HOME=/root -- a path that is not bind-mounted and is destroyed by `docker compose run --rm`. That gave every containerized build a cold cache while the host stayed warm. Setting this makes computeSharedDataLocation return {share:'none'}, so host resolves <repo>/.nx/cache and the container resolves /code/.nx/cache -- the same physical directory through the ./:/code bind mount. NX_CACHE_DIRECTORY in docker-compose.yml would NOT work: the host would keep using ~/.nx. Matches .circleci/config.yml, which sets NX_CACHE_DIRECTORY for the same reason.",
  "cacheDirectory": ".nx/cache",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/tsconfig.base.json", "{workspaceRoot}/package-lock.json"],
    "production": [
      "default",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/vitest.config.mts",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s",
      "!{projectRoot}/cypress/**/*",
      "!{projectRoot}/**/*.cy.[jt]s?(x)",
      "!{projectRoot}/cypress.config.[jt]s"
    ]
  },
  "tui": {
    "enabled": false
  },
  "cli": {
    "packageManager": "npm"
  },
  "targetDefaults": {
    "@angular/build:application": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production", "{workspaceRoot}/.browserslistrc"]
    },
    "@nx/angular:package": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production", "{workspaceRoot}/.browserslistrc"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "run-many": {},
    "run-all-tests": {
      "dependsOn": ["build"],
      "inputs": ["default", "^default", "{workspaceRoot}/vitest.preset.config.mts", "{workspaceRoot}/vitest.setup.*.ts"],
      "outputs": ["{projectRoot}/.reports/vitest/{projectName}.junit.xml"],
      "cache": true
    },
    "run-tests": {
      "cache": true,
      "dependsOn": ["build"],
      "inputs": ["default", "^production", "{workspaceRoot}/vitest.preset.config.mts", "{workspaceRoot}/vitest.setup.*.ts"],
      "outputs": ["{projectRoot}/.reports/vitest/{projectName}.junit.xml"]
    },
    "test": {
      "cache": true,
      "dependsOn": ["build"],
      "inputs": ["default", "^production", "{workspaceRoot}/vitest.preset.config.mts", "{workspaceRoot}/vitest.setup.*.ts"],
      "outputs": ["{projectRoot}/.reports/vitest/{projectName}.junit.xml"]
    },
    "ci-publish-npmjs": {},
    "deploy": {
      "dependsOn": ["build"]
    },
    "ci-deploy": {
      "dependsOn": ["build"]
    },
    "e2e": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "build-base": {
      "cache": true,
      "inputs": ["production", "^production"]
    },
    "@nx/eslint:lint": {
      "cache": false,
      "inputs": ["default", "{workspaceRoot}/eslint.config.mjs", "{workspaceRoot}/eslint.config.angular.mjs", "{workspaceRoot}/eslint.config.library.mjs"],
      "options": {
        "cache": true,
        "cacheLocation": ".cache/eslint",
        "cacheStrategy": "content"
      }
    },
    "@nx/js:tsc": {
      "cache": true,
      "inputs": ["production", "^production"]
    },
    "ci-deploy-prod": {
      "cache": false
    },
    "ci-deploy-staging": {
      "cache": false
    }
  },
  "generators": {
    "@nx/angular:application": {
      "style": "scss",
      "linter": "eslint",
      "unitTestRunner": "vitest",
      "e2eTestRunner": "cypress"
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "vitest"
    },
    "@nx/angular:component": {
      "style": "scss"
    }
  },
  "defaultProject": "demo",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "packages"
  },
  "pluginsConfig": {
    "@nx/js": {
      "analyzeSourceFiles": true
    }
  },
  "useInferencePlugins": false,
  "neverConnectToCloud": true,
  "defaultBase": "main",
  "release": {
    "projects": ["*"],
    "projectsRelationship": "fixed",
    "version": {
      "conventionalCommits": true,
      "git": {
        "commit": false,
        "tag": false,
        "stageChanges": false
      }
    },
    "releaseTag": {
      "requireSemver": true,
      "pattern": "v{version}"
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": false,
        "file": "{workspaceRoot}/CHANGELOG.md",
        "renderOptions": {
          "authors": false,
          "applyUsernameToAuthors": false,
          "commitReferences": true,
          "versionTitleDate": true
        }
      },
      "projectChangelogs": {
        "createRelease": false,
        "file": "{projectRoot}/CHANGELOG.md",
        "renderOptions": {
          "authors": false,
          "applyUsernameToAuthors": false,
          "commitReferences": true,
          "versionTitleDate": true
        }
      },
      "automaticFromRef": true,
      "git": {
        "commit": true,
        "commitMessage": "release($workspace): v{version} release",
        "commitArgs": "--no-verify",
        "tag": false,
        "tagMessage": "v{version}",
        "stageChanges": true
      }
    }
  },
  "analytics": false,
  "plugins": [
    {
      "plugin": "@nx/rollup/plugin",
      "options": {
        "buildTargetName": "build-base"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "testMode": "run"
      }
    },
    {
      "comment": "targetName is pinned rather than left to @nx/oxlint's fallback chain ('lint' -> 'oxlint' -> ...): 'lint' is taken by 90 project.json files, so the generator would land on 'oxlint' anyway, but only by accident of ordering.",
      "plugin": "@nx/oxlint",
      "options": {
        "targetName": "oxlint"
      }
    }
  ],
  "migrate": {
    "agentic": true
  }
}
