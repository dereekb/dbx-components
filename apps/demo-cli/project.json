{
  "name": "demo-cli",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/demo-cli/src",
  "projectType": "library",
  "tags": [],
  "implicitDependencies": ["dbx-cli", "dbx-cli-firebase-api-manifest", "util", "firebase", "date", "model", "rxjs", "demo-firebase"],
  "targets": {
    "generate-api-manifest": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/src/lib/manifest/api.manifest.generated.ts"],
      "dependsOn": [
        {
          "projects": ["dbx-cli"],
          "target": "build"
        }
      ],
      "inputs": ["{workspaceRoot}/dist/packages/dbx-cli/firebase-api-manifest/main.js", "{workspaceRoot}/components/demo-firebase/src/lib/functions.ts", "{workspaceRoot}/components/demo-firebase/src/lib/**/*.api.ts", "{workspaceRoot}/packages/firebase/src/lib/model/**/*.api.ts"],
      "options": {
        "command": "node dist/packages/dbx-cli/firebase-api-manifest/main.js --project=demo-cli --functions-config=components/demo-firebase/src/lib/functions.ts --output=apps/demo-cli/src/lib/manifest/api.manifest.generated.ts --emit-models",
        "cwd": "{workspaceRoot}"
      }
    },
    "generate-firestore-query-manifest": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/src/lib/manifest/query.manifest.generated.ts"],
      "dependsOn": [
        {
          "projects": ["dbx-cli"],
          "target": "build"
        }
      ],
      "inputs": [
        "{workspaceRoot}/dist/packages/dbx-cli/firestore-query-manifest/main.js",
        "{workspaceRoot}/components/demo-firebase/dbx-mcp.scan.json",
        "{workspaceRoot}/components/demo-firebase/package.json",
        "{workspaceRoot}/components/demo-firebase/src/lib/**/*.query.ts",
        "{workspaceRoot}/components/demo-firebase/src/lib/**/*.ts",
        "{workspaceRoot}/packages/openrouter/firebase/dbx-mcp.scan.json",
        "{workspaceRoot}/packages/openrouter/firebase/package.json",
        "{workspaceRoot}/packages/openrouter/firebase/src/lib/**/*.query.ts",
        "{workspaceRoot}/packages/openrouter/firebase/src/lib/**/*.ts",
        "{workspaceRoot}/packages/firebase/dbx-mcp.scan.json",
        "{workspaceRoot}/packages/firebase/package.json",
        "{workspaceRoot}/packages/firebase/src/lib/**/*.query.ts",
        "{workspaceRoot}/packages/firebase/src/lib/**/*.ts",
        "{workspaceRoot}/firestore.rules"
      ],
      "options": {
        "command": "node dist/packages/dbx-cli/firestore-query-manifest/main.js --project=demo-cli --component=components/demo-firebase --component=packages/openrouter/firebase --component=packages/firebase --output=apps/demo-cli/src/lib/manifest/query.manifest.generated.ts --rules=firestore.rules",
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "dependsOn": ["generate-api-manifest", "generate-firestore-query-manifest"],
      "options": {
        "outputPath": "dist/apps/demo-cli",
        "main": "apps/demo-cli/src/index.ts",
        "tsConfig": "apps/demo-cli/tsconfig.lib.json",
        "format": ["esm"],
        "platform": "node",
        "target": "node20",
        "bundle": true,
        "thirdParty": false,
        "skipTypeCheck": true,
        "declaration": false,
        "external": ["class-validator", "class-transformer"],
        "esbuildOptions": {
          "banner": {
            "js": "#!/usr/bin/env node\nimport { createRequire as __createRequire } from 'node:module';\nconst require = __createRequire(import.meta.url);"
          }
        },
        "assets": [
          {
            "glob": "LICENSE",
            "input": ".",
            "output": "."
          }
        ]
      },
      "configurations": {
        "production": {
          "minify": true,
          "sourcemap": false
        }
      }
    },
    "build-standalone": {
      "//": "The single self-contained artifact shipped through the API's signed asset-download path. `thirdParty: true` is what makes it runnable outside the workspace - the default build leaves yargs/rxjs/firebase/date-fns as bare imports against a `private: true` package.json full of peerDependencies, so downloading that file alone gets you a CLI that cannot start. The externals below are oxfmt's OPTIONAL prettier plugins (Astro/Twig/Pug/Liquid/Marko/...), reached only through lazy import() for languages this CLI never formats; they are not installed, so bundling them is a hard resolve error. oxfmt itself is reached only by the codegen scan-helpers, never by a CLI command. Exposed as its own target rather than a `build` configuration because apps/demo-api's copy-cli-artifact needs it as a dependsOn edge, and TargetDependencyConfig has no `configuration` field (node_modules/nx/dist/src/config/workspace-json-project-json.d.ts:150). Invoking it as a nested `npx nx run demo-cli:build:standalone` instead is what deadlocked `demo-api:serve`: demo-cli -> demo-api is a static graph edge, so the nested process re-entered demo-api while serve/build-watch were registered running and blocked on \"Waiting for demo-api:serve in another nx process\".",
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["generate-api-manifest", "generate-firestore-query-manifest"],
      "options": {
        "outputPath": "dist/apps/demo-cli-standalone",
        "main": "apps/demo-cli/src/index.ts",
        "tsConfig": "apps/demo-cli/tsconfig.lib.json",
        "format": ["esm"],
        "platform": "node",
        "target": "node20",
        "bundle": true,
        "thirdParty": true,
        "skipTypeCheck": true,
        "declaration": false,
        "external": ["class-validator", "class-transformer", "@prettier/plugin-oxc", "@prettier/plugin-hermes", "@prettier/plugin-pug", "prettier-plugin-astro", "prettier-plugin-marko", "@zackad/prettier-plugin-twig", "@shopify/prettier-plugin-liquid"],
        "esbuildOptions": {
          "banner": {
            "js": "#!/usr/bin/env node\nimport { createRequire as __createRequire } from 'node:module';\nconst require = __createRequire(import.meta.url);"
          }
        },
        "assets": [
          {
            "glob": "LICENSE",
            "input": ".",
            "output": "."
          }
        ],
        "minify": true,
        "sourcemap": false
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": [],
      "dependsOn": ["generate-api-manifest", "generate-firestore-query-manifest"],
      "options": {
        "commands": ["npx tsc -p apps/demo-cli/tsconfig.lib.json --noEmit", "npx tsc -p apps/demo-cli/tsconfig.spec.json --noEmit"],
        "cwd": "{workspaceRoot}",
        "parallel": false
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./exec-with-emulator.sh 'npx nx run-tests demo-cli'"
      }
    },
    "run-tests": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "{projectRoot}"
      }
    },
    "watch": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./exec-with-emulator.sh 'npx nx run-tests demo-cli --watch'"
      }
    }
  }
}
